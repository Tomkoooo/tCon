{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "IPC for tCon's own UI: the webview labelled `main` only, at the app's local origin. Child webviews (e.g. `browser-*`) and remote origins get no IPC.",
  "local": true,
  "webviews": [
    "main"
  ],
  "permissions": [
    "app-commands",
    "core:default",
    "core:window:allow-set-badge-count",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" },
        { "url": "mailto:*" }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "dialog:default",
    "notification:default"
  ]
}
